---
import { mainNavItems, isNavGroup } from '../data/nav';

interface Props {
  variant?: 'default' | 'home';
}

const { variant = 'default' } = Astro.props;
const isHome = variant === 'home';
const logoHref = isHome ? '#' : '/';
const ctaHref = isHome ? '#signup' : '/#signup';

// On the homepage, in-page anchors like /#why should become #why so they
// scroll instead of navigating. Off-home, leave the absolute path alone.
const hrefFor = (href: string) =>
  isHome && href.startsWith('/#') ? href.slice(1) : href;
---
<nav>
  <div class="nav-inner">
    <a href={logoHref} class="nav-logo">liv<span>4all</span></a>

    <div class="nav-links">
      {mainNavItems.map((item) => (
        isNavGroup(item) ? (
          <div class="nav-dropdown" data-nav-dropdown>
            <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
              {item.label}
              <span class="nav-dropdown-chev" aria-hidden="true">▾</span>
            </button>
            <div class="nav-dropdown-menu" role="menu">
              {item.links.map((link) => (
                <a href={hrefFor(link.href)} role="menuitem">{link.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={hrefFor(item.href)}>{item.label}</a>
        )
      ))}
      <a href="https://app.liv4all.com" class="nav-login">login</a>
      <a href={ctaHref} class="nav-cta">join waitlist</a>
    </div>

    <button type="button" class="nav-hamburger" aria-label="open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="nav-mobile" id="mobile-menu" hidden>
    <div class="nav-mobile-inner">
      {mainNavItems.map((item) => (
        isNavGroup(item) ? (
          <div class="nav-mobile-group">
            <div class="nav-mobile-group-label">{item.label}</div>
            {item.links.map((link) => (
              <a href={hrefFor(link.href)} class="nav-mobile-sublink">{link.label}</a>
            ))}
          </div>
        ) : (
          <a href={hrefFor(item.href)} class="nav-mobile-link">{item.label}</a>
        )
      ))}
      <a href="https://app.liv4all.com" class="nav-mobile-link">login</a>
      <a href={ctaHref} class="nav-mobile-cta">join waitlist</a>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    const hamburger = document.querySelector('.nav-hamburger');
    const mobile = document.getElementById('mobile-menu');
    if (hamburger && mobile) {
      const setOpen = (open) => {
        hamburger.setAttribute('aria-expanded', String(open));
        hamburger.classList.toggle('is-open', open);
        if (open) {
          mobile.removeAttribute('hidden');
          requestAnimationFrame(() => mobile.classList.add('is-open'));
        } else {
          mobile.classList.remove('is-open');
          setTimeout(() => mobile.setAttribute('hidden', ''), 200);
        }
      };
      hamburger.addEventListener('click', () => {
        setOpen(hamburger.getAttribute('aria-expanded') !== 'true');
      });
      mobile.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setOpen(false));
      });
    }

    document.querySelectorAll('[data-nav-dropdown]').forEach((dd) => {
      const trigger = dd.querySelector('.nav-dropdown-trigger');
      if (!trigger) return;
      const close = () => {
        dd.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      };
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = !dd.classList.contains('is-open');
        document.querySelectorAll('[data-nav-dropdown].is-open').forEach((other) => {
          if (other !== dd) {
            other.classList.remove('is-open');
            other.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
          }
        });
        dd.classList.toggle('is-open', open);
        trigger.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', (e) => {
        if (!dd.contains(e.target)) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    });
  })();
</script>
