---
import { getMainNavItems, isNavGroup } from '../data/nav';
import { alternateUrl, ui, type Lang } from '../i18n';

interface Props {
  variant?: 'default' | 'home';
  lang?: Lang;
}

const { variant = 'default', lang = 'en' } = Astro.props;
const isHome = variant === 'home';
const homeBase = lang === 'pt-br' ? '/pt-br/' : '/';
const logoHref = isHome ? '#' : homeBase;
const ctaHref = 'https://app.liv4all.com';

const navItems = getMainNavItems(lang);
const t = ui[lang];

// Language toggle targets, derived from the current page. Pages without a
// counterpart in the other language fall back to that language's home.
const enUrl = alternateUrl(Astro.url.pathname, 'en');
const ptUrl = alternateUrl(Astro.url.pathname, 'pt-br');

// On the homepage, in-page anchors like /#why (or /pt-br/#why) should become
// #why so they scroll instead of navigating. Off-home, leave the path alone.
const hrefFor = (href: string) =>
  isHome && href.startsWith(`${homeBase}#`) ? href.slice(homeBase.length) : href;
---
<nav>
  <div class="nav-inner">
    <a href={logoHref} class="nav-logo">liv<span>4all</span></a>

    <div class="nav-links">
      {navItems.map((item) => (
        isNavGroup(item) ? (
          <div class="nav-dropdown" data-nav-dropdown>
            <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
              {item.label}
              <span class="nav-dropdown-chev" aria-hidden="true">▾</span>
            </button>
            <div class="nav-dropdown-menu" role="menu">
              {item.links.map((link) => (
                <a href={hrefFor(link.href)} role="menuitem">{link.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={hrefFor(item.href)}>{item.label}</a>
        )
      ))}
      <div class="nav-lang" aria-label="Language / Idioma">
        <a href={enUrl} class:list={[{ 'is-active': lang === 'en' }]} aria-current={lang === 'en' ? 'true' : undefined} hreflang="en">EN</a>
        <span class="nav-lang-sep" aria-hidden="true">/</span>
        <a href={ptUrl} class:list={[{ 'is-active': lang === 'pt-br' }]} aria-current={lang === 'pt-br' ? 'true' : undefined} hreflang="pt-BR">PT</a>
      </div>
      <a href="https://app.liv4all.com" class="nav-login">{t.login}</a>
      <a href={ctaHref} class="nav-cta">{t.startTrial}</a>
    </div>

    <button type="button" class="nav-hamburger" aria-label="open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="nav-mobile" id="mobile-menu" hidden>
    <div class="nav-mobile-inner">
      {navItems.map((item) => (
        isNavGroup(item) ? (
          <div class="nav-mobile-group">
            <div class="nav-mobile-group-label">{item.label}</div>
            {item.links.map((link) => (
              <a href={hrefFor(link.href)} class="nav-mobile-sublink">{link.label}</a>
            ))}
          </div>
        ) : (
          <a href={hrefFor(item.href)} class="nav-mobile-link">{item.label}</a>
        )
      ))}
      <div class="nav-lang nav-lang-mobile" aria-label="Language / Idioma">
        <a href={enUrl} class:list={[{ 'is-active': lang === 'en' }]} hreflang="en">EN</a>
        <span class="nav-lang-sep" aria-hidden="true">/</span>
        <a href={ptUrl} class:list={[{ 'is-active': lang === 'pt-br' }]} hreflang="pt-BR">PT</a>
      </div>
      <a href="https://app.liv4all.com" class="nav-mobile-link">{t.login}</a>
      <a href={ctaHref} class="nav-mobile-cta">{t.startTrial}</a>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    const hamburger = document.querySelector('.nav-hamburger');
    const mobile = document.getElementById('mobile-menu');
    if (hamburger && mobile) {
      const setOpen = (open) => {
        hamburger.setAttribute('aria-expanded', String(open));
        hamburger.classList.toggle('is-open', open);
        if (open) {
          mobile.removeAttribute('hidden');
          requestAnimationFrame(() => mobile.classList.add('is-open'));
        } else {
          mobile.classList.remove('is-open');
          setTimeout(() => mobile.setAttribute('hidden', ''), 200);
        }
      };
      hamburger.addEventListener('click', () => {
        setOpen(hamburger.getAttribute('aria-expanded') !== 'true');
      });
      mobile.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setOpen(false));
      });
    }

    document.querySelectorAll('[data-nav-dropdown]').forEach((dd) => {
      const trigger = dd.querySelector('.nav-dropdown-trigger');
      if (!trigger) return;
      const close = () => {
        dd.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      };
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = !dd.classList.contains('is-open');
        document.querySelectorAll('[data-nav-dropdown].is-open').forEach((other) => {
          if (other !== dd) {
            other.classList.remove('is-open');
            other.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
          }
        });
        dd.classList.toggle('is-open', open);
        trigger.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', (e) => {
        if (!dd.contains(e.target)) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    });
  })();
</script>
