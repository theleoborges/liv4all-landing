---
interface Props {
  title: string;
  desc: string;
  videoSrc: string;
}

const { title, desc, videoSrc } = Astro.props;
---
<div class="player-container fade-in">
  <video src={videoSrc} controls playsinline preload="metadata"></video>
  <h1 class="player-title">{title}</h1>
  <p class="player-desc">{desc}</p>
  <a href="/" class="back-link">← liv4all.com</a>
</div>

<style>
  .player-container {
    width: min(640px, 100%);
    text-align: center;
    background: var(--surface-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 20px;
  }

  .player-container video {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border-light);
    background: var(--surface);
  }

  .player-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 20px;
    margin-bottom: 8px;
  }

  .player-desc {
    font-size: 0.9rem;
    color: var(--text-dim);
    max-width: 480px;
    margin: 0 auto 24px;
  }

  .back-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s;
  }

  .back-link:hover { text-decoration: underline; }
</style>
