---
import { getFooterLinks, getHomeFooterExtras } from '../data/nav';
import { ui, type Lang } from '../i18n';

interface Props {
  variant?: 'default' | 'home';
  lang?: Lang;
}

const { variant = 'default', lang = 'en' } = Astro.props;
const footerLinks = getFooterLinks(lang);
const homeBase = lang === 'pt-br' ? '/pt-br/' : '/';
const links = variant === 'home'
  ? [...getHomeFooterExtras(lang), ...footerLinks.filter((l) => l.href !== homeBase && l.href !== '/')]
  : footerLinks;
---
<footer>
  <div class="container-wide">
    <div class="footer-links">
      {links.map((link) => (
        link.external
          ? <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
          : <a href={link.href}>{link.label}</a>
      ))}
    </div>
    <p>{ui[lang].footerTagline}</p>
  </div>
</footer>
