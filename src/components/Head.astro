---
import { OG_LOCALES, canonicalUrl, isTranslatedRoute, toEnglishRoute, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  ogUrl: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
  lang?: Lang;
}

const {
  title,
  description,
  ogUrl,
  ogType = 'website',
  ogTitle = title,
  ogDescription = description,
  canonical,
  lang = 'en',
} = Astro.props;

// Pages that exist in both languages advertise each other via hreflang.
const hasAlternates = isTranslatedRoute(Astro.url.pathname);
const englishRoute = toEnglishRoute(Astro.url.pathname);
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{hasAlternates && (
  <>
    <link rel="alternate" hreflang="en" href={canonicalUrl(englishRoute, 'en')} />
    <link rel="alternate" hreflang="pt-BR" href={canonicalUrl(englishRoute, 'pt-br')} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl(englishRoute, 'en')} />
  </>
)}
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={ogUrl} />
<meta property="og:locale" content={OG_LOCALES[lang]} />
<meta property="og:image" content="https://liv4all.com/og-image.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Liv — Less Admin. More Living." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://liv4all.com/og-image.png" />
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🖤</text></svg>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="alternate" type="application/rss+xml" title="Liv4All — Articles" href="/rss.xml" />
