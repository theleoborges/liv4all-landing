---
<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  ogDescription={copy.ogDescription}
  ogUrl={canonicalUrl('/', lang)}
  canonical={canonicalUrl('/', lang)}
  variant="home"
  customFadeIn={true}
  lang={lang}
>
  <section class="hero">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>
    <div class="hero-content">
      <div class="badge">
        <span class="badge-dot"></span>
        {copy.hero.badge}
      </div>
      <img src="/logo.png" alt={copy.hero.logoAlt} class="hero-logo" />
      <h1>{copy.hero.h1}<br><span class="typing-line"><span class="gradient typing" id="typed-role"></span><span class="cursor">|</span></span></h1>
      <p class="hero-sub" set:html={copy.hero.sub} />
      <div class="hero-cta">
        <a href="https://app.liv4all.com" class="btn-primary">{copy.hero.ctaPrimary}</a>
        <a href="https://www.youtube.com/watch?v=TXaWeFTb9Ns" target="_blank" rel="noopener" class="btn-secondary">{copy.hero.ctaSecondary}</a>
      </div>
      <p class="hero-cta-note">{copy.hero.ctaNote}</p>
      <div class="trust-strip">
        {copy.hero.trustItems.map((item, i) => (
          <>
            {i > 0 && <div class="trust-divider"></div>}
            <div class="trust-item"><span class="trust-icon">{item.icon}</span> {item.text}</div>
          </>
        ))}
      </div>
    </div>
    <div class="scroll-hint">
      {copy.hero.scrollHint}
      <span>↓</span>
    </div>
  </section>

  <section id="why">
    <div class="container-wide fade-in">
      <div class="section-label">{copy.why.label}</div>
      <h2 set:html={copy.why.heading} />
      <p class="prose" set:html={copy.why.prose} />

      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon">{copy.why.firstCard.icon}</div>
          <div>
            <h3 set:html={copy.why.firstCard.title} />
            <p set:html={copy.why.firstCard.body} />
          </div>
        </div>

        {copy.why.cards.map((card) => (
          <div class="why-card">
            <div class="why-icon">{card.icon}</div>
            <h3 set:html={card.title} />
            <p set:html={card.body} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="in-action" class="section-lifted">
    <div class="container-wide fade-in">
      <div class="section-label">{copy.inAction.label}</div>
      <h2 set:html={copy.inAction.heading} />

      <div class="chat-carousel">
        <div class="chat-carousel-track" id="carouselTrack">
          {copy.slides.map((slide) => (
            <div class="chat-slide">
              <div class={`chat-phone chat-${slide.platform}`}>
                <div class="chat-header">
                  <div class={`chat-avatar chat-avatar-${slide.platform}`}>🖤</div>
                  <div class="chat-name">Liv</div>
                  <div class="chat-platform">{slide.platformLabel}</div>
                </div>
                <div class="chat-body">
                  {slide.messages.map((msg) =>
                    msg.from === 'user' ? (
                      <div class="chat-msg chat-msg-user" set:html={msg.html} />
                    ) : (
                      <div class="chat-msg chat-msg-agent">
                        <div class="agent-name">{copy.agentName}</div>
                        <Fragment set:html={msg.html} />
                      </div>
                    )
                  )}
                </div>
              </div>
              <div class="chat-slide-label">
                <span class="label-tag">{slide.labelTag}</span>
                <p>{slide.caption}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="carousel-controls">
          <button class="carousel-btn" id="carouselPrev" aria-label={copy.carousel.prev}>←</button>
          <div class="carousel-dots" id="carouselDots">
            {copy.slides.map((_, i) => (
              <div class:list={['carousel-dot', i === 0 && 'active']} data-slide={String(i)}></div>
            ))}
          </div>
          <button class="carousel-btn" id="carouselNext" aria-label={copy.carousel.next}>→</button>
        </div>
      </div>
    </div>
  </section>

  <div class="demo-fullscreen" id="demoFullscreen">
    <video playsinline id="demoFullscreenVideo"></video>
    <button class="demo-fullscreen-close" id="demoFullscreenClose">&times;</button>
  </div>

  <section id="demos">
    <div class="container-wide fade-in">
      <div class="section-label">{copy.demos.label}</div>
      <h2 set:html={copy.demos.heading} />
      <p class="prose">{copy.demos.prose}</p>

      <div class="demos-grid">
        {copy.demos.cards.map((demo) => (
          <div class="demo-card">
            <div class="demo-video-wrap">
              <video src={demo.src} playsinline muted preload="metadata"></video>
              <div class="demo-play-btn"></div>
              <button class="demo-expand-btn" aria-label={copy.demos.expandLabel}></button>
            </div>
            <div class="demo-caption">
              <h3 set:html={demo.title} />
              <p set:html={demo.body} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="features" class="section-glow">
    <div class="container-wide fade-in">
      <div class="section-label">{copy.features.label}</div>
      <h2 set:html={copy.features.heading} />
      <p class="prose">{copy.features.prose}</p>

      <div class="features-grid">
        {copy.features.cards.map((card) => (
          <div class:list={['feature-card', card.wide && 'feature-wide']}>
            <span class={`feature-badge ${card.badgeClass}`}>{card.badge}</span>
            <div class="feat-icon">{card.icon}</div>
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="integrations" class="section-lifted">
    <div class="container-wide fade-in" style="text-align: center;">
      <div class="section-label">{copy.integrations.label}</div>
      <h2 set:html={copy.integrations.heading} />
      <div class="integrations-strip">
        {copy.integrations.chips.map((chip) => (
          <div class="chip"><span class="chip-icon">{chip.icon}</span> {chip.name}{chip.soon && <Fragment>{' '}<span style="font-size: 0.7rem; color: var(--amber);">{copy.integrations.soon}</span></Fragment>}</div>
        ))}
      </div>
    </div>
  </section>

  <section id="origin">
    <div class="container-wide fade-in">
      <div class="section-label">{copy.origin.label}</div>
      <h2 set:html={copy.origin.heading} />
      <p class="prose" set:html={copy.origin.paras[0]} />
      <p class="prose" style="margin-top: 16px;" set:html={copy.origin.paras[1]} />
      <p class="prose" style="margin-top: 16px;" set:html={copy.origin.paras[2]} />

      <a href="https://open.substack.com/pub/leonardoborges/p/tltd-39-voice-ai-the-next-platform?utm_source=liv4all.com&utm_medium=referral&utm_campaign=landing" target="_blank" rel="noopener" class="article-card">
        <div class="article-tag">{copy.origin.articleTag}</div>
        <h3>{copy.origin.articleTitle}</h3>
        <p>{copy.origin.articleBody}</p>
      </a>
    </div>
  </section>

  <section id="docs" class="section-lifted">
    <div class="container-wide fade-in">
      <div class="section-label">{copy.docs.label}</div>
      <h2 set:html={copy.docs.heading} />

      <p class="docs-intro" set:html={copy.docs.intro} />

      <details class="docs-toggle">
        <summary>{copy.docs.setup.summary}</summary>
        <div class="docs-toggle-body">
          <p set:html={copy.docs.setup.intro} />

          <ol class="docs-steps">
            {copy.docs.setup.steps.map((step) => (
              <li>
                <span class="step-title">{step.title}</span>
                <Fragment set:html={step.body} />
              </li>
            ))}
          </ol>

          <div class="docs-callout-info" style="margin-top: 20px;" set:html={copy.docs.setup.callout} />
        </div>
      </details>

      <details class="docs-toggle" style="margin-top: 12px;">
        <summary>{copy.docs.after.summary}</summary>
        <div class="docs-toggle-body">
          <p>{copy.docs.after.intro}</p>
          <ul style="margin: 12px 0; padding-left: 20px;">
            {copy.docs.after.items.map((item) => (
              <li style="margin-bottom: 8px;" set:html={item} />
            ))}
          </ul>
        </div>
      </details>

      <details class="docs-toggle" style="margin-top: 12px;">
        <summary>{copy.docs.alpha.summary}</summary>
        <div class="docs-toggle-body">
          <p set:html={copy.docs.alpha.paras[0]} />
          <p style="margin-top: 12px;" set:html={copy.docs.alpha.paras[1]} />
          <p style="margin-top: 12px;" set:html={copy.docs.alpha.paras[2]} />
        </div>
      </details>
    </div>
  </section>

  <section id="waitlist" class="signup-section">
    <div class="container-wide">
      <div class="signup-wrapper">
        <!-- State A: cap has room (default) -->
        <div class="signup-state" id="state-open">
          <div class="section-label">{copy.signup.open.label}</div>
          <h2 set:html={copy.signup.open.heading} />
          <p class="prose">
            <Fragment set:html={copy.signup.open.proseLead} />
            <strong id="spots-line">{copy.signup.open.spotsLine}</strong>
          </p>
          <div class="signup-cta-wrap">
            <a href="https://app.liv4all.com" class="btn-primary">{copy.signup.open.cta}</a>
            <p class="form-note">{copy.signup.open.note}</p>
          </div>
        </div>

        <!-- State B: cap full (hidden by default; revealed by JS when remaining === 0) -->
        <div class="signup-state" id="state-full" hidden>
          <div class="section-label">{copy.signup.full.label}</div>
          <h2 set:html={copy.signup.full.heading} />
          <p class="prose" set:html={copy.signup.full.prose} />

          <form class="signup-form" id="interest-form" action="https://formspree.io/f/xzdawwzo" method="POST">
            <div class="form-row">
              <input type="text" name="name" placeholder={copy.signup.full.namePlaceholder} required />
              <input type="email" name="email" placeholder={copy.signup.full.emailPlaceholder} required />
            </div>
            <input type="text" name="use_case" placeholder={copy.signup.full.useCasePlaceholder} />
            <input type="hidden" name="_subject" value="Liv4All — Waitlist Signup" />
            <input type="hidden" name="source" value="waitlist" />
            <button type="submit">{copy.signup.full.button}</button>
            <p class="form-note" set:html={copy.signup.full.note} />
          </form>

          <div class="form-success" id="form-success">
            <div class="check">🖤</div>
            <h3 set:html={copy.signup.success.heading} />
            <p set:html={copy.signup.success.body} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ typedRoles: copy.typedRoles, formCopy: copy.script }}>
    (function() {
      const roles = typedRoles;
      const el = document.getElementById('typed-role');
      let roleIndex = 0;
      let charIndex = 0;
      let isDeleting = false;

      function tick() {
        const current = roles[roleIndex];

        if (!isDeleting) {
          el.textContent = current.substring(0, charIndex + 1);
          charIndex++;
          if (charIndex === current.length) {
            isDeleting = true;
            return setTimeout(tick, 2000);
          }
          return setTimeout(tick, 80);
        } else {
          el.textContent = current.substring(0, charIndex - 1);
          charIndex--;
          if (charIndex === 0) {
            isDeleting = false;
            roleIndex = (roleIndex + 1) % roles.length;
            return setTimeout(tick, 400);
          }
          return setTimeout(tick, 40);
        }
      }

      tick();
    })();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          entry.target.querySelectorAll('.why-card, .feature-card, .demo-card').forEach((card, i) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            card.style.transitionDelay = `${i * 0.08}s`;
            requestAnimationFrame(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            });
          });
        }
      });
    }, { threshold: 0.05 });

    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const href = a.getAttribute('href');
        if (href === '#' || href.length <= 1) return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    (() => {
      const track = document.getElementById('carouselTrack');
      const dots = document.querySelectorAll('.carousel-dot');
      const prev = document.getElementById('carouselPrev');
      const next = document.getElementById('carouselNext');
      let current = 0;
      const total = dots.length;

      function goTo(i) {
        current = ((i % total) + total) % total;
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, idx) => d.classList.toggle('active', idx === current));
      }

      prev.addEventListener('click', () => goTo(current - 1));
      next.addEventListener('click', () => goTo(current + 1));
      dots.forEach(d => d.addEventListener('click', () => goTo(+d.dataset.slide)));

      let startX = 0;
      track.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
      track.addEventListener('touchend', e => {
        const diff = startX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) goTo(current + (diff > 0 ? 1 : -1));
      }, { passive: true });

      let autoplay = setInterval(() => goTo(current + 1), 6000);
      const carousel = document.querySelector('.chat-carousel');
      carousel.addEventListener('mouseenter', () => clearInterval(autoplay));
      carousel.addEventListener('mouseleave', () => { autoplay = setInterval(() => goTo(current + 1), 6000); });
    })();

    document.querySelectorAll('.demo-video-wrap').forEach(wrap => {
      const video = wrap.querySelector('video');
      const btn = wrap.querySelector('.demo-play-btn');

      wrap.addEventListener('click', () => {
        if (video.paused) {
          document.querySelectorAll('.demo-video-wrap').forEach(other => {
            const v = other.querySelector('video');
            const b = other.querySelector('.demo-play-btn');
            if (v !== video) { v.pause(); b.classList.remove('hidden'); }
          });
          video.play();
          btn.classList.add('hidden');
        } else {
          video.pause();
          btn.classList.remove('hidden');
        }
      });

      video.addEventListener('ended', () => btn.classList.remove('hidden'));
    });

    const fsOverlay = document.getElementById('demoFullscreen');
    const fsVideo = document.getElementById('demoFullscreenVideo');
    const fsClose = document.getElementById('demoFullscreenClose');

    document.querySelectorAll('.demo-expand-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = btn.closest('.demo-video-wrap');
        const src = card.querySelector('video');
        src.pause();
        card.querySelector('.demo-play-btn').classList.remove('hidden');
        fsVideo.src = src.src;
        fsVideo.currentTime = src.currentTime;
        fsOverlay.classList.add('active');
        fsVideo.play();
        document.body.style.overflow = 'hidden';
      });
    });

    function closeFsVideo() {
      fsVideo.pause();
      fsOverlay.classList.remove('active');
      fsVideo.removeAttribute('src');
      document.body.style.overflow = '';
    }

    fsClose.addEventListener('click', closeFsVideo);
    fsOverlay.addEventListener('click', (e) => { if (e.target === fsOverlay) closeFsVideo(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && fsOverlay.classList.contains('active')) closeFsVideo(); });

    const form = document.getElementById('interest-form');
    const success = document.getElementById('form-success');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button');
        btn.disabled = true;
        btn.textContent = formCopy.submitting;

        try {
          const resp = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' }
          });

          if (resp.ok) {
            form.style.display = 'none';
            success.style.display = 'block';
          } else {
            btn.textContent = formCopy.error;
            btn.disabled = false;
          }
        } catch {
          btn.textContent = formCopy.networkError;
          btn.disabled = false;
        }
      });
    }

    (async () => {
      const stateOpen = document.getElementById('state-open');
      const stateFull = document.getElementById('state-full');
      const spotsLine = document.getElementById('spots-line');
      if (!stateOpen || !stateFull) return;

      try {
        const resp = await fetch('https://app.liv4all.com/api/spots', { cache: 'no-store' });
        if (!resp.ok) return;
        const { remaining, cap } = await resp.json();
        if (typeof remaining !== 'number' || typeof cap !== 'number') return;

        if (remaining <= 0) {
          stateOpen.hidden = true;
          stateFull.hidden = false;
        } else if (spotsLine) {
          spotsLine.textContent = formCopy.spotsTemplate
            .replace('{remaining}', remaining)
            .replace('{cap}', cap);
        }
      } catch {
        // network/CORS failure: leave the static "limited spots" fallback in place
      }
    })();
  </script>
</BaseLayout>

