---
<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  ogDescription={copy.ogDescription}
  ogUrl={canonicalUrl('/pricing', lang)}
  canonical={canonicalUrl('/pricing', lang)}
  lang={lang}
>
  <section class="pricing-hero">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="container-wide">
      <div class="hero-content fade-in">
        <div class="section-label">{copy.heroLabel}</div>
        <h1 set:html={copy.heroTitle} />
        <p class="hero-sub">{copy.heroSub}</p>
      </div>

      <div class="differentiators fade-in fade-in-delay-1">
        {copy.diffs.map((d) => (
          <div class="diff-card">
            <div class="diff-icon">{d.icon}</div>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="plans-section">
    <div class="container-wide">
      <div class="billing-toggle fade-in" role="tablist" aria-label={copy.billingAria}>
        <button type="button" class="billing-btn is-active" data-billing="monthly" role="tab" aria-selected="true">{copy.monthly}</button>
        <button type="button" class="billing-btn" data-billing="annual" role="tab" aria-selected="false">
          {copy.annual} <span class="save-pill">{copy.savePill}</span>
        </button>
      </div>

      <div class="plans-grid fade-in fade-in-delay-1">
        {copy.plans.map((plan) => (
          <div class={plan.featured ? 'plan-card plan-card-featured' : 'plan-card'}>
            {plan.featured && <div class="plan-glow"></div>}
            <div class="plan-header">
              <div class={plan.featured ? 'plan-tag plan-tag-featured' : 'plan-tag'}>{plan.tag}</div>
              <h2 class="plan-name">{plan.name}</h2>
              <p class="plan-tagline">{plan.tagline}</p>
            </div>
            <div class="plan-price">
              <div class="price-monthly" data-price-for="monthly">
                <span class="price-currency">$</span><span class="price-amount">{plan.monthlyAmount}</span><span class="price-suffix">{copy.perMonth}</span>
              </div>
              <div class="price-annual" data-price-for="annual" hidden>
                <span class="price-currency">$</span><span class="price-amount">{plan.annualAmount}</span><span class="price-suffix">{copy.perMonth}</span>
                <div class="price-billed">{plan.billed}</div>
              </div>
            </div>
            <a href="https://app.liv4all.com" class={plan.featured ? 'plan-cta plan-cta-featured' : 'plan-cta'}>{plan.cta}</a>
            <ul class="plan-features">
              {plan.features.map((f) => (
                <li set:html={f} />
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="plans-fineprint fade-in fade-in-delay-2" set:html={copy.fineprint} />
    </div>
  </section>

  <section class="replaces-section section-lifted">
    <div class="container-wide">
      <div class="replaces fade-in">
        <div class="section-label">{copy.mathLabel}</div>
        <p class="replaces-line" set:html={copy.replacesLine} />
        <p class="replaces-sub">{copy.replacesSub}</p>
      </div>
    </div>
  </section>

  <section class="scenarios-section">
    <div class="container-wide">
      <div class="fade-in">
        <div class="section-label">{copy.practiceLabel}</div>
        <h2 set:html={copy.practiceTitle} />
        <p class="prose">{copy.practiceSub}</p>
      </div>

      <div class="scenarios-grid fade-in fade-in-delay-1">
        {copy.scenarios.map((s) => (
          <div class={s.meta ? 'scenario-card scenario-card-meta' : 'scenario-card'}>
            <div class="scenario-prompt">{s.prompt}</div>
            <div class="scenario-note" set:html={s.note} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="compare" class="compare-section section-lifted">
    <div class="container-wide">
      <div class="fade-in">
        <div class="section-label">{copy.compareLabel}</div>
        <h2 set:html={copy.compareTitle} />
      </div>

      <div class="compare-table-wrap fade-in fade-in-delay-1">
        <table class="compare-table">
          <thead>
            <tr>
              <th></th>
              <th>Pro<br /><span class="th-price">{copy.thPricePro}</span></th>
              <th>Max<br /><span class="th-price">{copy.thPriceMax}</span></th>
            </tr>
          </thead>
          <tbody>
            {copy.compareGroups.map((g) => (
              <>
                <tr class="row-group"><td colspan="3" set:html={g.group} /></tr>
                {g.rows.map((r) => (
                  <tr>
                    <td set:html={r.label} />
                    <td>{r.pro}</td>
                    <td>{r.max}</td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>

      <p class="compare-footnote fade-in" set:html={copy.footnote} />
    </div>
  </section>

  <section class="final-cta">
    <div class="container-wide">
      <div class="final-cta-inner fade-in">
        <div class="section-label">{copy.ctaLabel}</div>
        <h2 set:html={copy.ctaTitle} />
        <p class="prose">{copy.ctaSub}</p>
        <a href="https://app.liv4all.com" class="plan-cta plan-cta-featured plan-cta-large">{copy.ctaButton}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const buttons = document.querySelectorAll('.billing-btn');
    const setBilling = (mode) => {
      buttons.forEach((b) => {
        const active = b.getAttribute('data-billing') === mode;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll('[data-price-for]').forEach((el) => {
        const matches = el.getAttribute('data-price-for') === mode;
        if (matches) el.removeAttribute('hidden');
        else el.setAttribute('hidden', '');
      });
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => setBilling(b.getAttribute('data-billing')))
    );
  })();
</script>

<style>
