---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { canonicalUrl, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  en: {
    metaTitle: 'WhatsApp FAQ — Liv4All',
    metaDescription: 'How WhatsApp works with Liv — Telegram is the default, WhatsApp is invite-only. eSIM setup, plan availability, and why we recommend a dedicated number.',
    heading: 'whatsapp & liv',
    subtitle: `telegram is the default — it's all you need to sign up and get going. whatsapp is an optional, invite-only add-on. here's exactly how it works.`,
    callout: `already set up on telegram and want whatsapp too? the <a href="/guides/whatsapp-onboarding">step-by-step onboarding guide</a> walks you through linking it. this page explains the what and why first.`,
    groups: [
      {
        label: '// the short version',
        items: [
          {
            q: 'do i need whatsapp to use liv?',
            a: `<p>no. <strong>telegram is the default channel and the only one you need</strong> — it's the sign-up flow and it's required. whatsapp is an optional extra you can add once your agent is already running on telegram.</p>`,
          },
          {
            q: 'is whatsapp available to everyone?',
            a: `<p><span class="badge-coming">invite only</span> not yet. whatsapp is invite-only because we have to set your agent up against a dedicated phone number on our side — it isn't something you can switch on yourself. once we've configured it, you can talk to liv on whatsapp just like you do on telegram.</p>`,
          },
        ],
      },
      {
        label: '// getting set up',
        items: [
          {
            q: 'how do i get whatsapp turned on?',
            a: `<p>three steps:</p>
          <ul>
            <li>get a dedicated number for your agent — any cheap prepaid eSIM works fine</li>
            <li>email that number to <a href="mailto:support@liv4all.com">support@liv4all.com</a> so we can whitelist and configure it</li>
            <li>follow the <a href="/guides/whatsapp-onboarding">onboarding guide</a> to link it</li>
          </ul>
          <p>already chatting with liv on telegram? you can ask there too.</p>`,
          },
          {
            q: 'why does my agent need its own eSIM / number?',
            a: `<p>so it has its own whatsapp identity, completely separate from your personal whatsapp. that keeps the agent away from your contacts and your private chats, and means it only ever sees the messages meant for it. it's the setup we recommend for everyone.</p>`,
          },
          {
            q: 'can i just use my own personal number instead?',
            a: `<p>technically yes, but we really don't recommend it, and here's why:</p>
          <ul>
            <li>you'd have to message <strong>yourself</strong> on whatsapp to talk to liv</li>
            <li>the agent gets access to <strong>all</strong> your contacts</li>
            <li>it may reply in your group chats and DMs instead of you — confusing friends and family</li>
            <li>you'll burn through credits much faster, because the agent has to process <strong>every</strong> message you receive, even the ones it never responds to</li>
          </ul>
          <p>if you've read all that and still want to use your own number, email <a href="mailto:support@liv4all.com">support@liv4all.com</a> — we can set it up once you've accepted those trade-offs.</p>`,
          },
        ],
      },
      {
        label: '// plans & pricing',
        items: [
          {
            q: 'which plans include whatsapp?',
            a: `<p>both, at different levels:</p>
          <ul>
            <li><strong>Pro</strong> — whatsapp DMs (1:1) with your agent</li>
            <li><strong>Max</strong> — whatsapp DMs <strong>plus</strong> group chats</li>
          </ul>
          <p>group chats are Max-only because a busy group can consume a lot more tokens than a one-to-one thread. see the full <a href="/pricing">pricing comparison</a>.</p>`,
          },
          {
            q: 'does whatsapp cost extra on top of my plan?',
            a: `<p>no — it's included at the levels above. the only thing you provide is the eSIM for your agent's number.</p>`,
          },
        ],
      },
    ],
    ctaHeading: 'ready to add whatsapp?',
    ctaLabel: 'follow the onboarding guide →',
  },
  'pt-br': {
    metaTitle: 'FAQ do WhatsApp — Liv4All',
    metaDescription: 'Como o WhatsApp funciona com a Liv — Telegram é o padrão, WhatsApp é só por convite. Configuração de eSIM, planos e por que recomendamos um número dedicado.',
    heading: 'whatsapp & liv',
    subtitle: `o telegram é o padrão — é tudo o que você precisa para se cadastrar e começar. o whatsapp é um extra opcional, disponível só por convite. aqui está exatamente como funciona.`,
    callout: `já configurou tudo no telegram e quer o whatsapp também? o <a href="/guides/whatsapp-onboarding">guia de onboarding passo a passo</a> mostra como vincular. esta página explica primeiro o quê e o porquê.`,
    groups: [
      {
        label: '// a versão curta',
        items: [
          {
            q: 'preciso de whatsapp para usar a liv?',
            a: `<p>não. <strong>o telegram é o canal padrão e o único de que você precisa</strong> — é o fluxo de cadastro e é obrigatório. o whatsapp é um extra opcional que você pode adicionar depois que seu agente já estiver rodando no telegram.</p>`,
          },
          {
            q: 'o whatsapp está disponível para todo mundo?',
            a: `<p><span class="badge-coming">só por convite</span> ainda não. o whatsapp é só por convite porque precisamos configurar seu agente com um número de telefone dedicado do nosso lado — não é algo que você consegue ativar sozinho. depois que configurarmos, você pode falar com a liv no whatsapp do mesmo jeito que fala no telegram.</p>`,
          },
        ],
      },
      {
        label: '// como configurar',
        items: [
          {
            q: 'como faço para ativar o whatsapp?',
            a: `<p>três passos:</p>
          <ul>
            <li>consiga um número dedicado para o seu agente — qualquer eSIM pré-pago barato serve</li>
            <li>envie esse número por email para <a href="mailto:support@liv4all.com">support@liv4all.com</a> para que a gente possa liberar e configurar</li>
            <li>siga o <a href="/guides/whatsapp-onboarding">guia de onboarding</a> para vincular</li>
          </ul>
          <p>já conversa com a liv no telegram? pode pedir por lá também.</p>`,
          },
          {
            q: 'por que meu agente precisa do próprio eSIM / número?',
            a: `<p>para que ele tenha a própria identidade no whatsapp, completamente separada do seu whatsapp pessoal. isso mantém o agente longe dos seus contatos e das suas conversas privadas, e garante que ele só veja as mensagens destinadas a ele. é a configuração que recomendamos para todo mundo.</p>`,
          },
          {
            q: 'posso usar meu número pessoal em vez disso?',
            a: `<p>tecnicamente sim, mas realmente não recomendamos, e aqui está o porquê:</p>
          <ul>
            <li>você teria que mandar mensagem para <strong>você mesmo</strong> no whatsapp para falar com a liv</li>
            <li>o agente ganha acesso a <strong>todos</strong> os seus contatos</li>
            <li>ele pode responder nos seus grupos e DMs no seu lugar — confundindo amigos e família</li>
            <li>você vai gastar créditos muito mais rápido, porque o agente precisa processar <strong>todas</strong> as mensagens que você recebe, até as que ele nunca responde</li>
          </ul>
          <p>se você leu tudo isso e ainda quer usar o próprio número, escreva para <a href="mailto:support@liv4all.com">support@liv4all.com</a> — podemos configurar assim que você tiver aceitado esses trade-offs.</p>`,
          },
        ],
      },
      {
        label: '// planos & preços',
        items: [
          {
            q: 'quais planos incluem whatsapp?',
            a: `<p>os dois, em níveis diferentes:</p>
          <ul>
            <li><strong>Pro</strong> — DMs no whatsapp (1:1) com seu agente</li>
            <li><strong>Max</strong> — DMs no whatsapp <strong>mais</strong> grupos</li>
          </ul>
          <p>grupos são exclusivos do Max porque um grupo movimentado pode consumir bem mais tokens do que uma conversa individual. veja a <a href="/pt-br/pricing">comparação completa de preços</a>.</p>`,
          },
          {
            q: 'o whatsapp custa algo a mais além do meu plano?',
            a: `<p>não — ele está incluído nos níveis acima. a única coisa que você fornece é o eSIM para o número do seu agente.</p>`,
          },
        ],
      },
    ],
    ctaHeading: 'pronto para adicionar o whatsapp?',
    ctaLabel: 'siga o guia de onboarding →',
  },
}[lang];
---
<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  ogUrl={canonicalUrl('/faq/whatsapp', lang)}
  canonical={canonicalUrl('/faq/whatsapp', lang)}
  lang={lang}
>
  <div class="container">
    <h1>{copy.heading}</h1>
    <p class="subtitle">{copy.subtitle}</p>

    <div class="callout fade-in">
      <p set:html={copy.callout} />
    </div>

    {copy.groups.map((group) => (
      <div class="faq-group fade-in">
        <div class="faq-group-label">{group.label}</div>

        {group.items.map((item) => (
          <details class="faq-toggle">
            <summary>{item.q}</summary>
            <div class="faq-toggle-body" set:html={item.a} />
          </details>
        ))}
      </div>
    ))}

    <div class="cta-block fade-in">
      <p>{copy.ctaHeading}</p>
      <a href="/guides/whatsapp-onboarding" class="cta-link">{copy.ctaLabel}</a>
    </div>
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .subtitle {
    font-size: 0.95rem;
    color: var(--text-dim);
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .callout {
    background: var(--accent-glow);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    margin-bottom: 48px;
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.7;
  }

  .callout :global(a) { color: var(--accent); }

  .faq-group { margin-bottom: 48px; }

  .faq-group-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: inline-block;
    padding: 6px 14px;
    background: var(--accent-glow);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: 100px;
  }

  .faq-toggle {
    background: var(--surface-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
    margin-bottom: 10px;
  }

  .faq-toggle:hover {
    border-color: rgba(139, 92, 246, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), 0 0 40px var(--accent-glow);
  }

  .faq-toggle summary {
    padding: 20px 24px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
    gap: 16px;
  }

  .faq-toggle summary::-webkit-details-marker { display: none; }

  .faq-toggle summary::after {
    content: '+';
    font-size: 1.2rem;
    color: var(--accent);
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .faq-toggle[open] summary::after { content: '−'; }

  .faq-toggle-body {
    padding: 0 24px 24px;
    font-size: 0.92rem;
    color: var(--text-dim);
    line-height: 1.7;
  }

  .faq-toggle-body :global(strong) { color: var(--text); font-weight: 500; }

  .faq-toggle-body :global(a) { color: var(--accent); }

  .faq-toggle-body :global(p + p) { margin-top: 12px; }

  .faq-toggle-body :global(ul) {
    padding-left: 20px;
    margin: 12px 0;
  }

  .faq-toggle-body :global(li) { margin-bottom: 8px; }

  .faq-toggle-body :global(.badge-live),
  .faq-toggle-body :global(.badge-coming) {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 8px;
    border-radius: 100px;
    margin-right: 4px;
  }

  .faq-toggle-body :global(.badge-live) {
    color: var(--green);
    background: rgba(52, 211, 153, 0.1);
    border: 1px solid rgba(52, 211, 153, 0.2);
  }

  .faq-toggle-body :global(.badge-coming) {
    color: var(--amber);
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.2);
  }

  .cta-block {
    text-align: center;
    padding: 40px 24px;
    background: var(--surface-glass);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
  }

  .cta-block p {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 12px;
  }

  .cta-link {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
  }
</style>
