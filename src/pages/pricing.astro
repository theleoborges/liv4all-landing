---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Pricing — Liv4All"
  description="Simple pricing for Liv — your AI Chief of Staff. Pro at $79/mo, Max at $149/mo. Save with annual billing."
  ogDescription="Simple pricing for Liv — your AI Chief of Staff. Pro at $79/mo, Max at $149/mo."
  ogUrl="https://liv4all.com/pricing"
>
  <section class="pricing-hero">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="container-wide">
      <div class="hero-content fade-in">
        <div class="section-label">// pricing</div>
        <h1>simple pricing.<br /><span class="gradient">one agent. infinite jobs.</span></h1>
        <p class="hero-sub">
          two plans. no free tier, no starter trap. pick the one that matches how
          much you want Liv doing for you — change your mind any time.
        </p>
      </div>

      <div class="differentiators fade-in fade-in-delay-1">
        <div class="diff-card">
          <div class="diff-icon">💬</div>
          <h3>it comes to you</h3>
          <p>in telegram and whatsapp — the apps you already check 100 times a day. liv messages first when something matters.</p>
        </div>
        <div class="diff-card">
          <div class="diff-icon">📥</div>
          <h3>really manages your inbox + calendar</h3>
          <p>reads, triages, drafts replies, reschedules. google CASA tier 2 verified for production gmail and calendar access.</p>
        </div>
        <div class="diff-card">
          <div class="diff-icon">🛠️</div>
          <h3>open-ended, teachable workflows</h3>
          <p>drop in an api key, describe the job. liv figures it out. no waiting for us to ship the integration.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="plans-section">
    <div class="container-wide">
      <div class="billing-toggle fade-in" role="tablist" aria-label="billing period">
        <button type="button" class="billing-btn is-active" data-billing="monthly" role="tab" aria-selected="true">monthly</button>
        <button type="button" class="billing-btn" data-billing="annual" role="tab" aria-selected="false">
          annual <span class="save-pill">save up to $360</span>
        </button>
      </div>

      <div class="plans-grid fade-in fade-in-delay-1">
        <div class="plan-card">
          <div class="plan-header">
            <div class="plan-tag">start here</div>
            <h2 class="plan-name">Pro</h2>
            <p class="plan-tagline">the everyday chief of staff. for anyone who wants to stop living in their inbox.</p>
          </div>
          <div class="plan-price">
            <div class="price-monthly" data-price-for="monthly">
              <span class="price-currency">$</span><span class="price-amount">79</span><span class="price-suffix">/mo</span>
            </div>
            <div class="price-annual" data-price-for="annual" hidden>
              <span class="price-currency">$</span><span class="price-amount">63</span><span class="price-suffix">/mo</span>
              <div class="price-billed">$756 billed annually · save $192</div>
            </div>
          </div>
          <a href="/#signup" class="plan-cta">join the waitlist →</a>
          <ul class="plan-features">
            <li>telegram, whatsapp, email — talk to liv anywhere</li>
            <li>full calendar + gmail (read, triage, draft, reschedule)</li>
            <li>real-web browsing — books, signs in, fills forms</li>
            <li>unlimited reminders + scheduled tasks</li>
            <li>10-secret credential vault for byo api keys</li>
            <li>your own isolated container with long-term memory</li>
          </ul>
        </div>

        <div class="plan-card plan-card-featured">
          <div class="plan-glow"></div>
          <div class="plan-header">
            <div class="plan-tag plan-tag-featured">most capable</div>
            <h2 class="plan-name">Max</h2>
            <p class="plan-tagline">for people whose calendars are someone else's full-time job. liv becomes that person.</p>
          </div>
          <div class="plan-price">
            <div class="price-monthly" data-price-for="monthly">
              <span class="price-currency">$</span><span class="price-amount">149</span><span class="price-suffix">/mo</span>
            </div>
            <div class="price-annual" data-price-for="annual" hidden>
              <span class="price-currency">$</span><span class="price-amount">119</span><span class="price-suffix">/mo</span>
              <div class="price-billed">$1,428 billed annually · save $360</div>
            </div>
          </div>
          <a href="/#signup" class="plan-cta plan-cta-featured">join the waitlist →</a>
          <ul class="plan-features">
            <li><strong>everything in Pro</strong>, plus:</li>
            <li>higher usage tier + larger token cap</li>
            <li>unlimited credential vault</li>
            <li>early access to new capabilities</li>
            <li>dedicated support channel</li>
            <li>priority response on every message</li>
          </ul>
        </div>
      </div>

      <p class="plans-fineprint fade-in fade-in-delay-2">
        prices in usd. <a href="#compare">see the full feature comparison ↓</a>
      </p>
    </div>
  </section>

  <section class="replaces-section section-lifted">
    <div class="container-wide">
      <div class="replaces fade-in">
        <div class="section-label">// the math</div>
        <p class="replaces-line">
          replaces your <em>email app</em>, your <em>scheduler</em>, and your
          <em>research tool</em> — for less than the three combined.
        </p>
        <p class="replaces-sub">one agent that talks to you on telegram. one bill. no tab-switching.</p>
      </div>
    </div>
  </section>

  <section class="scenarios-section">
    <div class="container-wide">
      <div class="fade-in">
        <div class="section-label">// in practice</div>
        <h2>what people actually <em>ask liv to do</em></h2>
        <p class="prose">these aren't features on a roadmap. they're real prompts from real users this week.</p>
      </div>

      <div class="scenarios-grid fade-in fade-in-delay-1">
        <div class="scenario-card">
          <div class="scenario-prompt">"give me a daily brief of my investment portfolio."</div>
          <div class="scenario-note">pulls quotes, reads filings, summarises overnight moves before your coffee.</div>
        </div>
        <div class="scenario-card">
          <div class="scenario-prompt">"find a time that works with sarah thursday and send a meeting invite."</div>
          <div class="scenario-note">checks calendars, picks a slot, drafts the invite, waits for your ok, sends.</div>
        </div>
        <div class="scenario-card">
          <div class="scenario-prompt">"get me a reservation for 2 at santa catarina in sydney."</div>
          <div class="scenario-note">opens the booking site, picks a time, fills the form, confirms — like a real user, because it is one.</div>
        </div>
        <div class="scenario-card scenario-card-meta">
          <div class="scenario-prompt">"post for me on x.com daily about being an ai agent."</div>
          <div class="scenario-note">
            meta. and real — <a href="https://x.com/Liv_4all" target="_blank" rel="noopener">@Liv_4all</a> runs herself.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="compare" class="compare-section section-lifted">
    <div class="container-wide">
      <div class="fade-in">
        <div class="section-label">// full comparison</div>
        <h2>everything in <em>each plan</em></h2>
      </div>

      <div class="compare-table-wrap fade-in fade-in-delay-1">
        <table class="compare-table">
          <thead>
            <tr>
              <th></th>
              <th>Pro<br /><span class="th-price">$79/mo</span></th>
              <th>Max<br /><span class="th-price">$149/mo</span></th>
            </tr>
          </thead>
          <tbody>
            <tr class="row-group"><td colspan="3">where you talk to it</td></tr>
            <tr><td>telegram</td><td>✓</td><td>✓</td></tr>
            <tr><td>whatsapp</td><td>✓</td><td>✓</td></tr>
            <tr><td>email (talk to liv by email)</td><td>✓</td><td>✓</td></tr>
            <tr><td>comes to you proactively (briefings, nudges)</td><td>✓</td><td>✓</td></tr>

            <tr class="row-group"><td colspan="3">core capabilities</td></tr>
            <tr><td>q&amp;a, writing, drafting</td><td>✓</td><td>✓</td></tr>
            <tr><td>web search</td><td>✓</td><td>✓</td></tr>
            <tr><td>calendar (read, create, reschedule)</td><td>✓</td><td>✓</td></tr>
            <tr><td>email triage + draft replies (your gmail) <sup>1</sup></td><td>✓</td><td>✓</td></tr>
            <tr><td>real-web browsing (stealth, bypasses bot detection)</td><td>✓</td><td>✓</td></tr>
            <tr><td>reminders / scheduled tasks (cron)</td><td>unlimited</td><td>unlimited</td></tr>
            <tr><td>morning briefings, pre-meeting prep</td><td>✓</td><td>✓</td></tr>

            <tr class="row-group"><td colspan="3">open-ended workflows</td></tr>
            <tr><td>teach it ad-hoc workflows <em>("forward this pdf to my dropbox", "watch this url and ping me on changes")</em></td><td>✓</td><td>✓</td></tr>
            <tr><td>bring-your-own api keys (trello, notion, anything with an api)</td><td>✓</td><td>✓</td></tr>
            <tr><td>secret vault for credentials</td><td>10 secrets</td><td>unlimited</td></tr>

            <tr class="row-group"><td colspan="3">memory &amp; isolation</td></tr>
            <tr><td>your own isolated container (not a shared model)</td><td>✓</td><td>✓</td></tr>
            <tr><td>long-term memory across sessions</td><td>✓</td><td>✓</td></tr>
            <tr><td>cross-channel memory (mention X in telegram, follow up in whatsapp)</td><td>✓</td><td>✓</td></tr>

            <tr class="row-group"><td colspan="3">limits &amp; perks</td></tr>
            <tr><td>response priority</td><td>priority</td><td>priority + higher token cap</td></tr>
            <tr><td>message limit</td><td>standard tier</td><td>higher usage tier</td></tr>
            <tr><td>early access to new capabilities</td><td>—</td><td>✓</td></tr>
            <tr><td>dedicated support channel</td><td>—</td><td>✓</td></tr>
          </tbody>
        </table>
      </div>

      <p class="compare-footnote fade-in">
        <sup>1</sup> CASA Tier 2 verified — liv can read, triage, and draft from your own gmail with google's full security review.
      </p>
    </div>
  </section>

  <section class="final-cta">
    <div class="container-wide">
      <div class="final-cta-inner fade-in">
        <div class="section-label">// waitlist</div>
        <h2><em>waitlist open.</em></h2>
        <p class="prose">
          signups are paused while we clear google's CASA tier 2 review.
          drop your details and we'll reach out the moment they reopen.
        </p>
        <a href="/#signup" class="plan-cta plan-cta-featured plan-cta-large">join the waitlist →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const buttons = document.querySelectorAll('.billing-btn');
    const setBilling = (mode) => {
      buttons.forEach((b) => {
        const active = b.getAttribute('data-billing') === mode;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll('[data-price-for]').forEach((el) => {
        const matches = el.getAttribute('data-price-for') === mode;
        if (matches) el.removeAttribute('hidden');
        else el.setAttribute('hidden', '');
      });
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => setBilling(b.getAttribute('data-billing')))
    );
  })();
</script>

<style>
  /* ── Shared section primitives ── */
  section { padding: 100px 0; }
  .section-lifted { background: var(--surface); }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: inline-block;
    padding: 6px 14px;
    background: var(--accent-glow);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: 100px;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 20px;
  }

  h1 .gradient {
    background: linear-gradient(135deg, var(--accent), var(--pink));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text-dim);
    margin-bottom: 16px;
  }

  h2 em {
    color: var(--text);
    font-style: normal;
    font-weight: 700;
  }

  .prose {
    color: var(--text-dim);
    font-size: 1.05rem;
    max-width: 600px;
    line-height: 1.7;
  }

  /* ── Hero ── */
  .pricing-hero {
    position: relative;
    padding: 160px 0 80px;
    overflow: hidden;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    opacity: 0.5;
  }

  .hero-orb-1 {
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.25) 0%, transparent 70%);
    top: -100px; left: -100px;
  }

  .hero-orb-2 {
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(192, 132, 252, 0.18) 0%, transparent 70%);
    top: 20%; right: -80px;
  }

  .hero-content {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 64px;
    position: relative;
  }

  .hero-sub {
    font-size: 1.15rem;
    color: var(--text-dim);
    line-height: 1.7;
    max-width: 580px;
    margin: 0 auto;
  }

  .differentiators {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    position: relative;
  }

  .diff-card {
    background: var(--surface-glass);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 28px;
    transition: border-color 0.3s, transform 0.3s;
  }

  .diff-card:hover {
    border-color: rgba(139, 92, 246, 0.3);
    transform: translateY(-2px);
  }

  .diff-icon {
    font-size: 1.8rem;
    margin-bottom: 14px;
  }

  .diff-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }

  .diff-card p {
    font-size: 0.92rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  /* ── Billing toggle ── */
  .billing-toggle {
    display: inline-flex;
    margin: 0 auto 40px;
    padding: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  .billing-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    padding: 10px 22px;
    background: transparent;
    color: var(--text-dim);
    border: 0;
    border-radius: 100px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .billing-btn:hover {
    color: var(--text);
  }

  .billing-btn.is-active {
    background: var(--accent);
    color: #fff;
  }

  .save-pill {
    font-size: 0.7rem;
    padding: 2px 8px;
    background: rgba(255, 255, 255, 0.18);
    border-radius: 100px;
  }

  .billing-btn:not(.is-active) .save-pill {
    background: var(--accent-glow);
    color: var(--accent);
  }

  /* ── Plan cards ── */
  .plans-section {
    padding-top: 0;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
  }

  .plan-card {
    position: relative;
    background: var(--surface-glass);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .plan-card-featured {
    border-color: rgba(139, 92, 246, 0.4);
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.06) 0%, var(--surface-glass) 50%);
  }

  .plan-glow {
    position: absolute;
    inset: -1px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.3), transparent 60%);
    opacity: 0.4;
    pointer-events: none;
    z-index: 0;
  }

  .plan-card > * {
    position: relative;
    z-index: 1;
  }

  .plan-header {
    margin-bottom: 28px;
  }

  .plan-tag {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-dim);
    border-radius: 100px;
    margin-bottom: 14px;
  }

  .plan-tag-featured {
    background: var(--accent-glow);
    color: var(--accent);
    border: 1px solid rgba(139, 92, 246, 0.2);
  }

  .plan-name {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .plan-tagline {
    font-size: 0.95rem;
    color: var(--text-dim);
    line-height: 1.55;
  }

  .plan-price {
    margin-bottom: 28px;
    min-height: 84px;
  }

  .price-currency {
    font-size: 1.4rem;
    color: var(--text-dim);
    vertical-align: top;
    margin-right: 2px;
    position: relative;
    top: 8px;
  }

  .price-amount {
    font-size: 3.4rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .price-suffix {
    font-size: 1rem;
    color: var(--text-dim);
    margin-left: 4px;
  }

  .price-billed {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--text-dim);
    margin-top: 8px;
  }

  .plan-cta {
    display: block;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    padding: 14px 24px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 100px;
    transition: all 0.25s;
    margin-bottom: 28px;
  }

  .plan-cta:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--accent);
    color: var(--text);
    text-decoration: none;
  }

  .plan-cta-featured {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .plan-cta-featured:hover {
    background: #a78bfa;
    color: #fff;
    box-shadow: 0 8px 30px rgba(139, 92, 246, 0.4);
  }

  .plan-cta-large {
    display: inline-block;
    padding: 16px 36px;
    margin-bottom: 0;
    margin-top: 8px;
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .plan-features li {
    font-size: 0.92rem;
    color: var(--text-dim);
    line-height: 1.5;
    padding-left: 22px;
    position: relative;
  }

  .plan-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .plan-features li strong {
    color: var(--text);
    font-weight: 600;
  }

  .plans-fineprint {
    text-align: center;
    margin-top: 32px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .plans-fineprint a { color: var(--accent); }

  /* ── Replaces callout ── */
  .replaces {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .replaces-line {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .replaces-line em {
    color: var(--accent);
    font-style: normal;
    font-weight: 700;
  }

  .replaces-sub {
    font-size: 1rem;
    color: var(--text-dim);
  }

  /* ── Scenarios ── */
  .scenarios-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 48px;
  }

  .scenario-card {
    background: var(--surface-glass);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 28px;
    transition: border-color 0.3s, transform 0.3s;
  }

  .scenario-card:hover {
    border-color: rgba(139, 92, 246, 0.3);
    transform: translateY(-2px);
  }

  .scenario-prompt {
    font-size: 1.05rem;
    color: var(--text);
    line-height: 1.5;
    margin-bottom: 14px;
    font-weight: 500;
  }

  .scenario-note {
    font-size: 0.88rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .scenario-note a {
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
  }

  .scenario-card-meta {
    border-color: rgba(139, 92, 246, 0.25);
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.04) 0%, var(--surface-glass) 60%);
  }

  /* ── Compare table ── */
  .compare-table-wrap {
    margin-top: 40px;
    overflow-x: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    background: var(--surface-glass);
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
  }

  .compare-table th,
  .compare-table td {
    padding: 14px 20px;
    text-align: left;
    font-size: 0.92rem;
    border-bottom: 1px solid var(--border-light);
  }

