---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Ivy — Q&A agent for your website | Liv4All"
  description="Ivy is Liv's sidekick — a Q&A agent that answers your prospective customers' questions as they browse your site."
  ogUrl="https://liv4all.com/ivy"
>
  <div class="container">
    <div class="ivy-badge fade-in">
      <span class="ivy-badge-dot"></span> Q&amp;A AGENT
    </div>
    <h1 class="fade-in fade-in-delay-1">Ivy</h1>
    <p class="subtitle fade-in fade-in-delay-2">
      Liv's sidekick. A Q&amp;A agent to help your prospective customers understand your product as they visit your website.
    </p>

    <h2 class="section-title fade-in fade-in-delay-2">3 simple steps</h2>
    <div class="steps-grid fade-in fade-in-delay-3">
      <div class="step-card">
        <div class="step-card-top"></div>
        <div class="step-card-body">
          <div class="step-num">01</div>
          <div class="step-name">Define your tone of voice</div>
          <p class="step-body">
            Provide your brand's voice — or we'll help you design one. This is how Ivy will be perceived by visitors.
          </p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-card-top"></div>
        <div class="step-card-body">
          <div class="step-num">02</div>
          <div class="step-name">Curate the knowledge</div>
          <p class="step-body">
            Specify what Ivy should reference: your public website, internal documents, anything else you want the agent to draw from.
          </p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-card-top"></div>
        <div class="step-card-body">
          <div class="step-num">03</div>
          <div class="step-name">Embed the widget</div>
          <p class="step-body">
            Drop the embed snippet on your site. Ivy is live and answering questions — just like she's doing on this site right now.
          </p>
        </div>
      </div>
    </div>

    <h2 class="section-title fade-in">See it in action</h2>
    <div class="demo-frame fade-in fade-in-delay-1">
      <video
        src="/assets/videos/ivy-widget.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="Ivy widget answering a visitor's questions on a sample website"
      ></video>
    </div>
  </div>

  <section class="pricing-section">
    <div class="container-wide">
      <div class="pricing-header fade-in">
        <div class="section-label">// pricing</div>
        <h2 class="pricing-title">Simple pricing</h2>
        <p class="pricing-sub">Three tiers. Pick the one that fits your site.</p>
      </div>

      <div class="plans-grid fade-in fade-in-delay-1">
        <div class="plan-card">
          <div class="plan-header">
            <div class="plan-tag">essentials</div>
            <h3 class="plan-name">Starter</h3>
            <p class="plan-tagline">Everything you need to launch Ivy on your site.</p>
          </div>
          <div class="plan-price">
            <span class="price-currency">$</span><span class="price-amount">99</span><span class="price-suffix">/mo</span>
          </div>
          <a href="mailto:sales@liv4all.com" class="plan-cta">Get started</a>
          <ul class="plan-features">
            <li>"Powered by Liv4All" footer in widget</li>
            <li>Fair-use messaging, sized for typical SMB traffic</li>
            <li>Daily knowledge base refresh</li>
            <li>Analytics: messages + unique users</li>
          </ul>
        </div>

        <div class="plan-card plan-card-featured">
          <div class="plan-glow"></div>
          <div class="plan-header">
            <div class="plan-tag plan-tag-featured">most popular</div>
            <h3 class="plan-name">Pro</h3>
            <p class="plan-tagline">Make Ivy feel native to your brand.</p>
          </div>
          <div class="plan-price">
            <span class="price-currency">$</span><span class="price-amount">148</span><span class="price-suffix">/mo</span>
          </div>
          <a href="mailto:sales@liv4all.com" class="plan-cta plan-cta-featured">Get started</a>
          <ul class="plan-features">
            <li>White-label &mdash; your logo, your colours</li>
            <li>Fair-use messaging, sized for typical SMB traffic</li>
            <li>Daily knowledge base refresh</li>
            <li>Analytics: messages + unique users</li>
          </ul>
        </div>

        <div class="plan-card">
          <div class="plan-header">
            <div class="plan-tag">bespoke</div>
            <h3 class="plan-name">Enterprise</h3>
            <p class="plan-tagline">High-traffic sites and bespoke needs.</p>
          </div>
          <div class="plan-price">
            <div class="price-custom">Custom</div>
          </div>
          <a href="mailto:sales@liv4all.com?subject=Ivy%20Enterprise%20enquiry" class="plan-cta">Talk to sales</a>
          <ul class="plan-features">
            <li>White-label &mdash; your logo, your colours</li>
            <li>Custom usage commit and SLA</li>
            <li>Daily knowledge base refresh</li>
            <li>Analytics + dedicated support</li>
          </ul>
        </div>
      </div>

      <p class="plans-fineprint fade-in fade-in-delay-2">Prices in USD.</p>
    </div>
  </section>

  <div class="container">
    <div class="cta-block fade-in fade-in-delay-2">
      <h2 class="cta-title">Ready to get started?</h2>
      <p class="cta-sub">Tell us about your business and we'll set Ivy up for you.</p>
      <a class="btn-primary" href="mailto:sales@liv4all.com">Get in touch</a>
    </div>
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .subtitle {
    font-size: 1rem;
    color: var(--text-dim);
    margin-bottom: 56px;
    line-height: 1.65;
    max-width: 640px;
  }

  .ivy-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid rgba(139, 92, 246, 0.25);
    padding: 4px 10px;
    border-radius: 100px;
    margin-bottom: 20px;
  }

  .ivy-badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .section-title {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 64px 0 24px;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 720px) {
    .steps-grid { grid-template-columns: 1fr; }
  }

  .step-card {
    background: var(--surface-glass);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }

  .step-card:hover {
    border-color: rgba(139, 92, 246, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), 0 0 40px var(--accent-glow);
  }

  .step-card-top {
    height: 4px;
    background: linear-gradient(90deg, var(--accent), var(--pink));
    opacity: 0.7;
  }

  .step-card-body { padding: 24px; }

  .step-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    margin-bottom: 14px;
  }

  .step-name {
    font-size: 1.02rem;
    font-weight: 600;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .step-body {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.65;
  }

  .demo-frame {
    width: min(400px, 100%);
    margin: 0 auto;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
  }

  .demo-frame video {
    display: block;
    width: 100%;
    height: auto;
  }

  .cta-block {
    margin: 80px 0 40px;
    text-align: center;
  }

  .cta-title {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .cta-sub {
    font-size: 0.95rem;
    color: var(--text-dim);
    margin-bottom: 24px;
  }

  .btn-primary {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    padding: 16px 32px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary:hover {
    background: #a78bfa;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(139, 92, 246, 0.4);
    text-decoration: none;
    color: #fff;
  }

  /* ── Pricing section ── */
  .pricing-section {
    padding: 80px 0 40px;
  }

  .pricing-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 48px;
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: inline-block;
    padding: 6px 14px;
    background: var(--accent-glow);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: 100px;
  }

  .pricing-title {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    color: var(--text);
  }

  .pricing-sub {
    font-size: 1rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1100px;
    margin: 0 auto;
    align-items: stretch;
  }

  .plan-card {
    position: relative;
    background: var(--surface-glass);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .plan-card-featured {
    border-color: rgba(139, 92, 246, 0.4);
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.06) 0%, var(--surface-glass) 50%);
  }

  .plan-glow {
    position: absolute;
    inset: -1px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.3), transparent 60%);
    opacity: 0.4;
    pointer-events: none;
    z-index: 0;
  }

  .plan-card > * {
    position: relative;
    z-index: 1;
  }

  .plan-header {
    margin-bottom: 24px;
  }

  .plan-tag {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-dim);
    border-radius: 100px;
    margin-bottom: 14px;
  }

  .plan-tag-featured {
    background: var(--accent-glow);
    color: var(--accent);
    border: 1px solid rgba(139, 92, 246, 0.2);
  }

  .plan-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }

  .plan-tagline {
    font-size: 0.92rem;
    color: var(--text-dim);
    line-height: 1.55;
    margin: 0;
  }

  .plan-price {
    margin-bottom: 24px;
    min-height: 64px;
    display: flex;
    align-items: flex-end;
  }

  .price-currency {
    font-size: 1.3rem;
    color: var(--text-dim);
    margin-right: 2px;
    position: relative;
    top: 8px;
  }

  .price-amount {
    font-size: 3rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .price-suffix {
    font-size: 1rem;
    color: var(--text-dim);
    margin-left: 4px;
  }

  .price-custom {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .plan-cta {
    display: block;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    padding: 14px 24px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 100px;
    transition: all 0.25s;
    margin-bottom: 24px;
    text-decoration: none;
  }

  .plan-cta:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--accent);
    color: var(--text);
    text-decoration: none;
  }

  .plan-cta-featured {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .plan-cta-featured:hover {
    background: #a78bfa;
    color: #fff;
    box-shadow: 0 8px 30px rgba(139, 92, 246, 0.4);
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .plan-features li {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.5;
    padding-left: 22px;
    position: relative;
  }

  .plan-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .plans-fineprint {
    text-align: center;
    margin-top: 32px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  @media (max-width: 900px) {
    .plans-grid {
      grid-template-columns: 1fr;
      max-width: 440px;
    }
  }
</style>
