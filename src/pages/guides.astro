---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Guides — Liv4All"
  description="Guides for getting the most out of Liv — your AI Chief of Staff."
  ogUrl="https://liv4all.com/guides"
>
  <div class="container">
    <a href="/" class="back">&larr; back to liv4all</a>

    <h1>guides</h1>
    <p class="subtitle">step-by-step walkthroughs for getting the most out of your liv agent.</p>

    <a href="/guides/whatsapp-onboarding" class="guide-card">
      <span class="guide-card-label">alpha</span>
      <div class="guide-card-title">connect your agent to WhatsApp</div>
      <p class="guide-card-desc">link your liv agent to WhatsApp Business so you can chat with them on both Telegram and WhatsApp.</p>
    </a>
  </div>
</BaseLayout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 48px;
    transition: color 0.2s;
  }

  .back:hover { color: var(--accent); text-decoration: none; }

  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .subtitle {
    font-size: 0.95rem;
    color: var(--text-dim);
    margin-bottom: 48px;
    line-height: 1.6;
  }

  .guide-card {
    display: block;
    background: var(--surface-glass);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin-bottom: 16px;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }

  .guide-card:hover {
    border-color: rgba(139, 92, 246, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), 0 0 40px var(--accent-glow);
    text-decoration: none;
  }

  .guide-card-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 8px;
    border-radius: 100px;
    color: var(--green);
    background: rgba(52, 211, 153, 0.1);
    border: 1px solid rgba(52, 211, 153, 0.2);
    display: inline-block;
    margin-bottom: 12px;
  }

  .guide-card-title {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 8px;
  }

  .guide-card-desc {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.6;
  }
</style>
