---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosedNotice from '../components/ClosedNotice.astro';
---
<BaseLayout
  title="Liv4All — Alpha Feedback (closed)"
  description="The Liv alpha feedback survey is closed. Liv shuts down on 26 September 2026."
  ogUrl="https://liv4all.com/survey"
>
  <div class="survey-container fade-in">
    <div class="survey-header">
      <h1>Liv4All Alpha Feedback</h1>
      <p>this survey is closed</p>
    </div>

    <ClosedNotice>
      <strong>The alpha feedback survey is closed.</strong>
      Liv is shutting down: no new signups, and the platform shuts down on
      <strong>26 September 2026</strong>. If you have something to say, or you need an export
      or a deletion, email <a href="mailto:support@liv4all.com">support@liv4all.com</a> instead.
      I read everything.
      <a href="/shutdown">read the shutdown notice &rarr;</a>
    </ClosedNotice>
  </div>

</BaseLayout>

<style>
  .survey-container {
    width: min(800px, 100%);
    margin: 0 auto;
    padding: 3rem 24px;
    padding-top: 100px;
  }

  .survey-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .survey-header h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .survey-header p {
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .survey-header .time-badge {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 6px 14px;
    background: var(--accent-glow);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: 100px;
    font-size: 0.8rem;
    color: var(--pink);
  }

  .question {
    margin-bottom: 2.5rem;
  }

  .question-number {
    display: inline-block;
    padding: 6px 14px;
    background: var(--accent-glow);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: 100px;
    font-size: 0.75rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .question label {
    display: block;
    font-size: 1.05rem;
    font-weight: 500;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .question .hint {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  .options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--surface-glass);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    cursor: pointer;
    transition: all 0.2s;
  }

  .option:hover {
    border-color: rgba(139, 92, 246, 0.4);
    box-shadow: 0 0 20px var(--accent-glow);
  }

  .option input[type="radio"] {
    accent-color: var(--accent);
    width: 16px;
    height: 16px;
  }

  .option span {
    font-size: 0.95rem;
  }

  textarea {
    width: 100%;
    min-height: 100px;
    padding: 0.75rem 1rem;
    background: var(--surface-glass);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    color: var(--text);
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 0.95rem;
    resize: vertical;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  textarea:focus {
    outline: none;
    border-color: rgba(139, 92, 246, 0.4);
    box-shadow: 0 0 20px var(--accent-glow);
  }

  textarea::placeholder {
    color: #4a4a5a;
  }

  .submit-section {
    text-align: center;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
  }

  .submit-btn {
    display: inline-block;
    padding: 0.9rem 3rem;
    background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
    color: #fff;
    border: none;
    border-radius: 100px;
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(139, 92, 246, 0.4);
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .privacy-note {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: #4a4a5a;
  }

  .thank-you {
    display: none;
    text-align: center;
    padding: 4rem 1rem;
  }

  .thank-you h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .thank-you p {
    color: var(--text-dim);
    font-size: 1rem;
  }

  .thank-you .heart {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .section-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.06), transparent);
    margin: 2rem 0;
  }

  @media (max-width: 600px) {
    .survey-container { padding: 2rem 1rem; padding-top: 80px; }
    .survey-header h1 { font-size: 1.4rem; }
  }
</style>
