---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FadeInScript from '../components/FadeInScript.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description: string;
  ogUrl: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
  variant?: 'default' | 'home';
  customFadeIn?: boolean;
}

const { variant = 'default', customFadeIn = false, ...headProps } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <Head {...headProps} />
    <slot name="head" />
  </head>
  <body>
    <Nav variant={variant} />
    <slot />
    <Footer variant={variant} />
    {!customFadeIn && <FadeInScript />}
    <ChatWidget />
  </body>
</html>
