---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FadeInScript from '../components/FadeInScript.astro';
import ChatWidget from '../components/ChatWidget.astro';
import Analytics from '../components/Analytics.astro';
import { LANG_TAGS, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  ogUrl: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
  variant?: 'default' | 'home';
  customFadeIn?: boolean;
  lang?: Lang;
}

const { variant = 'default', customFadeIn = false, lang = 'en', ...headProps } = Astro.props;
---
<!DOCTYPE html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <Head {...headProps} lang={lang} />
    <slot name="head" />
  </head>
  <body>
    <Nav variant={variant} lang={lang} />
    <slot />
    <Footer variant={variant} lang={lang} />
    {!customFadeIn && <FadeInScript />}
    <ChatWidget />
    <Analytics />
  </body>
</html>
